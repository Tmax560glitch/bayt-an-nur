# Stripe TEST only — never put sk_test_* or sk_live_* in VITE_* variables.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
PUBLIC_SITE_URL=http://localhost:3000

# Supabase
VITE_SUPABASE_ANON_KEY=REPLACE_ME
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co

# Webhook Stripe (filet de sécurité si le client ne revient pas sur le site après paiement)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Clé "service_role" Supabase (Settings > API) — NE JAMAIS mettre dans VITE_*, utilisée uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
